
%% ------- Wavelet Convolution and ERP per Frequency -------
% 1. Builds ~30 wavelets logarithmically spaced between 2–80 Hz.
% 2. Uses adaptive cycles (3–10 cycles across the frequency range).
% 3. Performs convolution on each trial independently (trial-by-trial FFT convolution).
% 4. Extracts `real(convolution)` for the bandpassed signal per trial.
% 5. Averages across trials to produce an ERP per frequency, applies baseline correction, and plots a grid of ERPs (one subplot per frequency).
% 
% Key point: trial-wise convolution keeps single-trial structure intact prior to averaging (preferred when interested in trial variability or single-trial metrics).


clear; clc;
load sampleEEGdata

%% ------ Q1: Generate wavelets ------

min_freq = 2;
max_freq = 80;
num_frex = 30;

frex = logspace(log10(min_freq), log10(max_freq), num_frex);
time = -1:1/EEG.srate:1;

% Proper wavelet width scaling (cycles increase with frequency)
numcycles = logspace(log10(3), log10(10), num_frex); 
s = numcycles ./ (2*pi*frex);

wavelets = cell(num_frex,1);

for fi = 1:num_frex
    wavelets{fi} = exp(2*1i*pi*frex(fi).*time) .* ...
                   exp(-time.^2 ./ (2*s(fi)^2));
end


%% ------- Trial-wise Convolution -------


chan2use = 'fcz';
channel_data = squeeze(EEG.data(strcmpi(chan2use,{EEG.chanlocs.labels}),:,:));

n_points = EEG.pnts;
n_trials = EEG.trials;

eegconv_all = cell(num_frex,1);   % holds: (time × trials) per frequency

for fi = 1:num_frex
    
    wavelet = wavelets{fi};
    n_wavelet = length(wavelet);
    n_conv = n_points + n_wavelet - 1;
    
    fft_wavelet = fft(wavelet, n_conv);
    
    conv_result = zeros(n_points, n_trials);
    
    for trial = 1:n_trials
        
        sig = channel_data(:,trial).';
        fft_data = fft(sig, n_conv);
        
        conv_trial = ifft(fft_wavelet .* fft_data);
        
        halfw = ceil(n_wavelet/2);
        conv_trial = conv_trial(halfw:end-halfw+1); % trim edges
        
        conv_result(:,trial) = conv_trial;
    end
    
    eegconv_all{fi} = conv_result;
end


%% ----- Compute ERP per Frequency ------

baseline = EEG.times < 0;    % baseline period

ERP_freq = zeros(num_frex, n_points);

for fi = 1:num_frex
    data_fi = eegconv_all{fi};
    
    % Average over trials (real part is band-pass ERP)
    erp = mean(real(data_fi), 2);
    
    % Baseline correction
    erp = erp - mean(erp(baseline));
    
    ERP_freq(fi,:) = erp;
end


%% ------- Plot ERP per Frequency -------



figure
rows = 6; cols = 5;   % 30 frequencies → 6×5 grid
for fi = 1:num_frex
    subplot(rows, cols, fi)
    
    plot(EEG.times, ERP_freq(fi,:), 'k', 'linew', 1)
    title([num2str(round(frex(fi))) ' Hz'])
    
    set(gca,'xlim',[-200 800])
end

sgtitle('ERP per Wavelet Frequency at FCz(hardcoded)')
xlabel('Time (ms)')
ylabel('Amplitude (\muV)')

